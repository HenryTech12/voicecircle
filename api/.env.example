# ---------------------------------------------------------------- app
APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8000      # must be the public https URL of this API in live mode (Twilio webhooks + signature check, Resemble dataset fetch)
FRONTEND_ORIGIN=http://localhost:5173
DEMO_MODE=true                             # enables POST /demo/seed and /demo/reset

# ---------------------------------------------------------------- mock vs live
# true  = no external accounts needed. Calls, cloning, detection and SMS are simulated.
# false = real Twilio calls, Resemble cloning/detection and LLM scripts (fill in the keys below).
MOCK_PROVIDERS=true
MOCK_EVENT_DELAY=1.0                       # seconds between simulated call events
MOCK_AUTO_SENIOR=false                     # true = a scripted "senior" answers simulated calls by itself

# ---------------------------------------------------------------- database
DATABASE_URL=sqlite+aiosqlite:///./voicecircle.db
# Supabase: DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- auth
AUTH_MODE=local                            # local = email-only dev login | supabase = verify Supabase JWTs
LOCAL_JWT_SECRET=change-me-to-a-long-random-string-32-bytes
SUPABASE_URL=
SUPABASE_JWT_SECRET=                       # Project Settings > API > JWT secret (HS256 projects)
SUPABASE_SERVICE_ROLE_KEY=                 # needed for STORAGE_BACKEND=supabase

# ---------------------------------------------------------------- storage
STORAGE_BACKEND=local                      # local | supabase
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------- Twilio (live mode)
TWILIO_ACCOUNT_SID=                        # Console > Account Info (starts with AC)
TWILIO_AUTH_TOKEN=                         # Console > Account Info; also verifies X-Twilio-Signature on webhooks
TWILIO_FROM_NUMBER=                        # your Twilio phone number, +E.164
TWILIO_MESSAGING_SERVICE_SID=              # optional (MG...); if set, SMS is sent through it instead of From
TWILIO_SAY_VOICE=Polly.Joanna-Neural       # voice for disclosures and Hugh (<Say>)
TWILIO_SPEECH_LANGUAGE=en-US               # speech recognition language (see the language list in Twilio's <Gather> docs)
TWILIO_GATHER_TIMEOUT=6                    # seconds to wait for the senior to start talking
TWILIO_MAX_SILENCES=3                      # silent turns in a row before the call wraps up

# ---------------------------------------------------------------- Resemble AI (live mode)
# Voice cloning + text-to-speech: fish (free s2.1-pro-free model) or resemble
VOICE_PROVIDER=fish
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
# Resemble is still used for deepfake detection + speaker matching (optional)
RESEMBLE_API_KEY=
RESEMBLE_PROJECT_UUID=
RESEMBLE_FALLBACK_VOICE_UUID=              # stock voice for disclosures / Hugh

# ---------------------------------------------------------------- LLM (optional; keyword fallback is used when empty)
LLM_PROVIDER=openai                        # openai | groq | anthropic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini                      # groq example: llama-3.3-70b-versatile

# ---------------------------------------------------------------- tuning
DETECT_FAKE_THRESHOLD=0.5
DETECT_UNSURE_MARGIN=0.1
SPEAKER_MATCH_THRESHOLD=0.75
PRACTICE_MAX_TURNS=8
PRACTICE_MAX_SECONDS=240
SCHEDULER_ENABLED=false                    # true = place daily Hugh calls + due scheduled practice calls automatically
